# Optional OpenAI-compatible generation endpoint. Retrieval works without an LLM.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Production neural retrieval profile (requires requirements-ml.txt).
DENSE_BACKEND=lsa
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_BACKEND=heuristic
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

CORPUS_DIR=data/corpus
ABSTAIN_THRESHOLD=0.44
AUDIT_DB=artifacts/audit.db
